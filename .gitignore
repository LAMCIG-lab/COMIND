# Packaging / setuptools / pip
*.egg-info/
*.egg
.eggs/
build/
dist/
pip-wheel-metadata/
*.whl

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class
*.cpython-*.pyc

# Virtual environments (if created inside the repo)
.venv/
venv/
env/

# Data
notebooks/PPMI_with_beta_subtype_split.csv
notebooks/ppmi_filter.ipynb
*.csv
notebooks/ppmi_filter_2.ipynb

# Experiment array outputs (keep templates; ignore run artifacts)
experiment_pipeline/**/results/
experiment_pipeline/**/logs/
experiment_pipeline/pd_all/
*.md

# Experiments: only each folder's config.yaml and NOTES.md are tracked. Results,
# journals, logs and notebooks hold subject-level data (DUA) and never are.
/experiments/*
!/experiments/*/
/experiments/*/*
!/experiments/*/config.yaml
!/experiments/*/NOTES.md
