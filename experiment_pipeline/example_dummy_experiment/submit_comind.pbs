#!/bin/bash
#$ -N comind_dummy_demo
#$ -S /bin/bash
#$ -q compute.q
#$ -l h_vmem=2G
#$ -j y
#$ -o /ifs/loni/faculty/thompson/four_d/dsemchin/comind/experiment_pipeline/example_dummy_experiment/logs/
#$ -m n
#$ -t 1-2

set -eo pipefail

EXP_DIR="/ifs/loni/faculty/thompson/four_d/dsemchin/comind/experiment_pipeline/example_dummy_experiment"
COMIND_ROOT="/ifs/loni/faculty/thompson/four_d/dsemchin/comind"
cd "$EXP_DIR"

source /usr/local/bin/.anaconda3-bashrc
conda activate comind

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export PYTHONUNBUFFERED=1

# SGE task IDs start at 1; run_comind.py reads 0-indexed PBS_ARRAYID
export PBS_ARRAYID=$((SGE_TASK_ID - 1))

echo "JOB_ID=${JOB_ID:-}"
echo "SGE_TASK_ID=${SGE_TASK_ID:-0}"
echo "PBS_ARRAYID=${PBS_ARRAYID}"

python "${EXP_DIR}/run_comind.py"