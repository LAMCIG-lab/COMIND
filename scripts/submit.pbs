#!/bin/bash
# Generic COMIND worker array. Submitted by scripts/submit_arms.py, which sets
# -N, -o, -t and -v CONFIG=...,ARM=...,NSUB=...,COMIND_ROOT=...
#PBS -l nodes=1:ppn=1
#PBS -l walltime=72:00:00
#PBS -l mem=8gb
#PBS -j oe
#PBS -m a

set -eo pipefail
ARRAY_ID="${PBS_ARRAYID:-0}"
source ~/miniconda3/etc/profile.d/conda.sh
conda activate comind
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONUNBUFFERED=1
export PYTHONPATH="${COMIND_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
export XLA_FLAGS="${XLA_FLAGS:-} --xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1"
echo "PBS_JOBID=${PBS_JOBID:-} PBS_ARRAYID=${ARRAY_ID} CONFIG=${CONFIG} ARM=${ARM} NSUB=${NSUB}"
sleep $(( 3 * ARRAY_ID ))  # stagger journal opens
python "${COMIND_ROOT}/scripts/run_experiment.py" "${CONFIG}" --arm "${ARM}" --n-subtypes "${NSUB}"
